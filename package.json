{
  "name": "xpp-vscode",
  "displayName": "X++ AI Companion for D365FO",
  "description": "Dynamics 365 Finance & Operations X++ development tools for VS Code and AI agents.",
  "version": "0.1.0",
  "publisher": "nazmolla",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nazmolla/xpp-vscode.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "AI"
  ],
  "os": [
    "win32"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "xpp.mcp",
        "label": "X++ (D365FO)"
      }
    ],
    "commands": [
      {
        "command": "xpp.showEnvironment",
        "title": "Show Active Environment",
        "category": "X++"
      },
      {
        "command": "xpp.checkEnvironment",
        "title": "Check Environment Connection",
        "category": "X++"
      }
    ],
    "configuration": {
      "title": "X++",
      "properties": {
        "xpp.project": {
          "type": "string",
          "default": "",
          "description": "Full path of the D365FO project (.rnrproj) that new objects are added to. Defaults to the first .rnrproj in the workspace."
        },
        "xpp.environmentUrl": {
          "type": "string",
          "default": "",
          "description": "Dataverse URL of your unified developer environment, e.g. https://yourorg.crm.dynamics.com."
        },
        "xpp.auth.clientId": {
          "type": "string",
          "default": "",
          "description": "Optional Microsoft Entra app (client) ID to sign in with, if your tenant does not allow VS Code's default sign-in for Dataverse."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-server.ps1",
    "build": "npm run build:server && npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "typescript": "^5.6.0"
  }
}
