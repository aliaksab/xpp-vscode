{
  "name": "xpp-vscode",
  "displayName": "X++ AI Companion for D365FO",
  "description": "Dynamics 365 Finance & Operations X++ development in VS Code: code view, form designer, build, deploy and AI agent tools.",
  "version": "0.2.0",
  "publisher": "nazmolla",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nazmolla/xpp-vscode.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "AI"
  ],
  "os": [
    "win32"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.rnrproj",
    "onFileSystem:xpp",
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "xpp.mcp",
        "label": "X++ (D365FO)"
      }
    ],
    "languages": [
      {
        "id": "xpp",
        "aliases": ["X++", "xpp"],
        "extensions": [".xpp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xpp",
        "scopeName": "source.xpp",
        "path": "./syntaxes/xpp.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xpp",
          "title": "X++",
          "icon": "$(symbol-class)"
        }
      ]
    },
    "views": {
      "xpp": [
        {
          "id": "xpp.aot",
          "name": "Application Explorer"
        },
        {
          "id": "xpp.project",
          "name": "D365FO Project"
        },
        {
          "id": "xpp.tools",
          "name": "Dynamics 365"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xpp.aot",
        "contents": "No D365FO metadata found on this machine.\n[Connect to Environment](command:xpp.connectEnvironment)"
      },
      {
        "view": "xpp.project",
        "contents": "No D365FO project selected. A project is only needed to group your work; the Application Explorer and agent tools work without one.\n[Select D365FO Project](command:xpp.selectProject)"
      }
    ],
    "commands": [
      { "command": "xpp.openObject", "title": "Open Object…", "category": "X++", "icon": "$(search)" },
      { "command": "xpp.openDesigner", "title": "Open Designer", "category": "X++", "icon": "$(symbol-structure)" },
      { "command": "xpp.viewCode", "title": "View Code", "category": "X++", "icon": "$(code)" },
      { "command": "xpp.openFormDesigner", "title": "Open Form Layout…", "category": "X++", "icon": "$(layout)" },
      { "command": "xpp.aot.filter", "title": "Filter Application Explorer…", "category": "X++", "icon": "$(filter)" },
      { "command": "xpp.aot.clearFilter", "title": "Clear Filter", "category": "X++", "icon": "$(filter-filled)" },
      { "command": "xpp.aot.modelView", "title": "Model View", "category": "X++", "icon": "$(list-tree)" },
      { "command": "xpp.aot.classicView", "title": "Classic View", "category": "X++", "icon": "$(list-flat)" },
      { "command": "xpp.designer.new", "title": "New…", "category": "X++" },
      { "command": "xpp.tools.createModel", "title": "Create Model…", "category": "Dynamics 365" },
      { "command": "xpp.tools.updateModel", "title": "Update Model Parameters…", "category": "Dynamics 365" },
      { "command": "xpp.tools.modelDependencies", "title": "View Model Dependencies…", "category": "Dynamics 365" },
      { "command": "xpp.tools.createPackage", "title": "Create Deployment Package…", "category": "Dynamics 365" },
      { "command": "xpp.tools.findLabels", "title": "Find Labels…", "category": "Dynamics 365" },
      { "command": "xpp.tools.options", "title": "Options…", "category": "Dynamics 365" },
      { "command": "xpp.addToProject", "title": "Add to Project", "category": "Dynamics 365" },
      { "command": "xpp.createExtension", "title": "Create Extension", "category": "Dynamics 365" },
      { "command": "xpp.createCodeExtension", "title": "Create Code Extension", "category": "Dynamics 365" },
      { "command": "xpp.findReferences", "title": "Find References", "category": "Dynamics 365" },
      { "command": "xpp.openInBrowser", "title": "Open in Browser", "category": "Dynamics 365" },
      { "command": "xpp.openTableBrowser", "title": "Open Table Browser", "category": "Dynamics 365" },
      { "command": "xpp.designer.newMethod", "title": "New Method…", "category": "X++" },
      { "command": "xpp.designer.override", "title": "Override Method…", "category": "X++" },
      { "command": "xpp.designer.openMethod", "title": "View Code", "category": "X++" },
      { "command": "xpp.designer.delete", "title": "Delete", "category": "X++" },
      { "command": "xpp.build", "title": "Build Model", "category": "X++", "icon": "$(tools)" },
      { "command": "xpp.refreshProject", "title": "Refresh Project", "category": "X++", "icon": "$(refresh)" },
      { "command": "xpp.refreshAot", "title": "Refresh Application Explorer", "category": "X++", "icon": "$(refresh)" },
      { "command": "xpp.selectProject", "title": "Select D365FO Project…", "category": "X++", "icon": "$(project)" },
      { "command": "xpp.connectEnvironment", "title": "Connect to Environment…", "category": "X++" },
      { "command": "xpp.checkEnvironment", "title": "Check Environment Connection", "category": "X++" },
      { "command": "xpp.showEnvironment", "title": "Show Active Environment", "category": "X++" },
      { "command": "xpp.pac.signIn", "title": "Sign In to Environment (pac)", "category": "X++" },
      { "command": "xpp.pac.init", "title": "Initialize Deployment Solution (pac)", "category": "X++" },
      { "command": "xpp.pac.deploy", "title": "Deploy Models to Environment (pac)", "category": "X++" },
      { "command": "xpp.pac.dbSync", "title": "Synchronize Database (pac)", "category": "X++" }
    ],
    "menus": {
      "view/title": [
        { "command": "xpp.aot.filter", "when": "view == xpp.aot && !xpp.aot.filtered", "group": "navigation@0" },
        { "command": "xpp.aot.clearFilter", "when": "view == xpp.aot && xpp.aot.filtered", "group": "navigation@0" },
        { "command": "xpp.aot.modelView", "when": "view == xpp.aot && !xpp.aot.modelView", "group": "navigation@1" },
        { "command": "xpp.aot.classicView", "when": "view == xpp.aot && xpp.aot.modelView", "group": "navigation@1" },
        { "command": "xpp.openObject", "when": "view == xpp.aot", "group": "navigation@2" },
        { "command": "xpp.build", "when": "view == xpp.aot", "group": "navigation@3" },
        { "command": "xpp.refreshAot", "when": "view == xpp.aot", "group": "navigation@4" },
        { "command": "xpp.openObject", "when": "view == xpp.project", "group": "navigation@1" },
        { "command": "xpp.build", "when": "view == xpp.project", "group": "navigation@2" },
        { "command": "xpp.refreshProject", "when": "view == xpp.project", "group": "navigation@3" },
        { "command": "xpp.selectProject", "when": "view == xpp.project", "group": "navigation@4" }
      ],
      "view/item/context": [
        { "command": "xpp.openDesigner", "when": "(view == xpp.project || view == xpp.aot) && viewItem =~ /xppElement/", "group": "navigation@1" },
        { "command": "xpp.viewCode", "when": "(view == xpp.project || view == xpp.aot) && viewItem =~ /\\bcode\\b/", "group": "navigation@2" },
        { "command": "xpp.openFormDesigner", "when": "(view == xpp.project || view == xpp.aot) && viewItem =~ /\\bform\\b/", "group": "navigation@3" },
        { "command": "xpp.viewCode", "when": "(view == xpp.project || view == xpp.aot) && viewItem =~ /\\bcode\\b/", "group": "inline" },
        { "command": "xpp.addToProject", "when": "view == xpp.aot && viewItem =~ /xppElement/", "group": "2_project@1" },
        { "command": "xpp.createExtension", "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\bextensible\\b/", "group": "3_extend@1" },
        { "command": "xpp.createCodeExtension", "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\bcoc\\b/", "group": "3_extend@2" },
        { "command": "xpp.findReferences", "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\brefs\\b/", "group": "4_refs@1" },
        { "command": "xpp.openTableBrowser", "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\btable\\b/", "group": "5_run@1" },
        { "command": "xpp.openInBrowser", "when": "(view == xpp.aot || view == xpp.project) && viewItem =~ /\\bbrowser\\b/ && !(viewItem =~ /\\btable\\b/)", "group": "5_run@2" },
        { "command": "xpp.tools.updateModel", "when": "view == xpp.aot && viewItem == 'xppModel custom'", "group": "1_model@1" },
        { "command": "xpp.tools.modelDependencies", "when": "view == xpp.aot && viewItem =~ /xppModel/", "group": "1_model@2" }
      ],
      "webview/context": [
        { "command": "xpp.designer.openMethod", "when": "webviewId == 'xppElementDesigner' && xppIsMethod", "group": "1_open@1" },
        { "command": "xpp.designer.new", "when": "webviewId == 'xppElementDesigner' && xppEditable && xppCanAdd", "group": "2_new@1" },
        { "command": "xpp.designer.newMethod", "when": "webviewId == 'xppElementDesigner' && xppEditable && xppHasMethods", "group": "2_new@2" },
        { "command": "xpp.designer.override", "when": "webviewId == 'xppElementDesigner' && xppEditable && xppHasMethods", "group": "2_new@3" },
        { "command": "xpp.designer.delete", "when": "webviewId == 'xppElementDesigner' && xppEditable && xppCanDelete", "group": "9_delete@1" }
      ],
      "commandPalette": [
        { "command": "xpp.openDesigner", "when": "false" },
        { "command": "xpp.viewCode", "when": "false" },
        { "command": "xpp.designer.new", "when": "false" },
        { "command": "xpp.designer.newMethod", "when": "false" },
        { "command": "xpp.designer.override", "when": "false" },
        { "command": "xpp.designer.openMethod", "when": "false" },
        { "command": "xpp.designer.delete", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "xpp.openObject", "key": "ctrl+alt+o" },
      { "command": "xpp.build", "key": "ctrl+shift+b", "when": "resourceScheme == xpp || resourceExtname == .rnrproj" }
    ],
    "configuration": {
      "title": "X++",
      "properties": {
        "xpp.project": {
          "type": "string",
          "default": "",
          "description": "Full path of the D365FO project (.rnrproj) that new objects are added to. Defaults to the first .rnrproj in the workspace."
        },
        "xpp.environmentUrl": {
          "type": "string",
          "default": "",
          "description": "Dataverse URL of your unified developer environment, e.g. https://yourorg.crm.dynamics.com."
        },
        "xpp.auth.clientId": {
          "type": "string",
          "default": "",
          "description": "Optional Microsoft Entra app (client) ID to sign in with, if your tenant does not allow VS Code's default sign-in for Dataverse."
        },
        "xpp.build.crossReference": {
          "type": "boolean",
          "default": true,
          "description": "Update the cross-reference database while building, so where-used includes your code."
        },
        "xpp.build.runAppCheckerRules": {
          "type": "boolean",
          "default": false,
          "description": "Run AppChecker rules during the build."
        },
        "xpp.pacPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Power Platform CLI (pac). Defaults to pac on PATH."
        },
        "xpp.financeAndOperationsUrl": {
          "type": "string",
          "default": "",
          "description": "Web client URL of your environment (e.g. https://yourorg.operations.dynamics.com), used by Open in Browser and Open Table Browser."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-server.ps1",
    "build": "npm run build:server && npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "typescript": "^5.6.0"
  }
}
